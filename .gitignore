# التبعيات والبناء
node_modules/
.next/
render-sim/
out/

# الأسرار — لا تُرفع أبداً
.env
.env.*
*.pem
*.key

# قواعد بيانات محلية
db/
*.db
*.sqlite

# سجلات
*.log
nohup.out
tool-results/
final_check.json

# مواد بحث داخلية (أكواد مواقع مرجعية — حقوق ملكية — لا تُنشر)
research/
reference-material/
examples/

# مخرجات قابلة لإعادة التوليد — باستثناء أدلة خط الصفر المجمدة (استثناء مقصود وموثق في BASELINE_V5.md)
download/*
!download/baseline-v5/
scripts/*
!scripts/baseline-color-check.py

# نظام
.DS_Store
Thumbs.db

# ============================================
# إضافات ما بعد الاسترجاع (V10 Hygiene) — موثقة
# ============================================

# تعدد ملفات القفل: القفل القانوني package-lock.json (هو ما تستخدمه render.yaml)
# bun.lock يعيد توليده محرك بيئة المنصة عند كل تهيئة — لا يعكس حالة المشروع
bun.lock

# ملفات تديرها منصة الحاوية (خارج المشروع — لا معنى لتتبعها)
# ملاحظة: ملف إعداد البروكسي تُديره المنصة بحماية خاصة — يبقى متتبعاً (غير مؤذٍ)
.zscripts/
