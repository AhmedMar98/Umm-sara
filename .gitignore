# ============================================
# إضافات ما بعد الاسترجاع (V10 Hygiene) — موثقة
# ============================================

# تعدد ملفات القفل: القفل القانوني package-lock.json (هو ما تستخدمه render.yaml)
# bun.lock يعيد توليده محرك بيئة المنصة عند كل تهيئة — لا يعكس حالة المشروع
bun.lock

# ملفات تديرها منصة الحاوية (خارج المشروع — لا معنى لتتبعها)
# ملاحظة: ملف إعداد البروكسي تُديره المنصة بحماية خاصة — يبقى متتبعاً (غير مؤذٍ)
.zscripts/

# أثر توليد tsc — يتجدد مع كل فحص
tsconfig.tsbuildinfo

# حزمة توثيق Notion الجاهزة للاستيراد — تتبع لحمايتها من إعادة تدوير البيئة
!download/notion-umm-sarah/
!download/notion-umm-sarah.zip
